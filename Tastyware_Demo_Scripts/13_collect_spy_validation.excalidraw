      "link": null,
      "locked": false,
      "text": "SessionCollector [defined in this script]\nconfig, window, store (injected references)\nstate = CaptureState(config)\ninstruments: dict[str, Instrument]\n\ncollect(): runs two concurrent activities\n  collect_connections() -> connected()\n  persist_updates() -> flush()\n\nRefresh universe, subscribe, sample,\nreconcile candles, retry failed connections.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "collector",
      "originalText": "SessionCollector [defined in this script]\nconfig, window, store (injected references)\nstate = CaptureState(config)\ninstruments: dict[str, Instrument]\n\ncollect(): runs two concurrent activities\n  collect_connections() -> connected()\n  persist_updates() -> flush()\n\nRefresh universe, subscribe, sample,\nreconcile candles, retry failed connections.",
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "aN"
