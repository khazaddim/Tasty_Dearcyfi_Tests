    {
      "id": "notes",
      "type": "text",
      "x": 1900,
      "y": 3170,
      "width": 1104,
      "height": 287.5,
      "angle": 0,
      "strokeColor": "#cbd5e1",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 257,
      "version": 1,
      "versionNonce": 356,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793740800000,
      "link": null,
      "locked": false,
      "text": "Solid blue arrows: referencing row -> referenced record (logical join).\nDashed purple arrows: view -> source table (dependency, not a foreign key).\nPK marks declared primary keys. No FOREIGN KEY constraints are declared.\nOther fields are nullable in the DDL; do not infer mandatory relationships.\nJoin raw payloads by record_id, not run_id: payloads can be shared across runs.\nSymbol joins to instruments are logical and must account for effective versions.\ncycles, diagnostics and requests have NULL raw_record_id.\nTIMESTAMPTZ values are handled in UTC; feed numbers are unscaled.\nSchema 1 upgrades to 2; complete received-update history starts with schema 2.\nSource: collector_store.py (COMMON, TABLES and CollectorStore.__init__).",
      "fontSize": 23,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solid blue arrows: referencing row -> referenced record (logical join).\nDashed purple arrows: view -> source table (dependency, not a foreign key).\nPK marks declared primary keys. No FOREIGN KEY constraints are declared.\nOther fields are nullable in the DDL; do not infer mandatory relationships.\nJoin raw payloads by record_id, not run_id: payloads can be shared across runs.\nSymbol joins to instruments are logical and must account for effective versions.\ncycles, diagnostics and requests have NULL raw_record_id.\nTIMESTAMPTZ values are handled in UTC; feed numbers are unscaled.\nSchema 1 upgrades to 2; complete received-update history starts with schema 2.\nSource: collector_store.py (COMMON, TABLES and CollectorStore.__init__).",
      "autoResize": true,
      "lineHeight": 1.25
    },
